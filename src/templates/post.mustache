{{!
    @template local_chuspasocial/post

    Card that shows a single post of the wall.

    Classes required for JS:
    * post-item

    Data attributes required for JS:
    * data-postid
    * data-action=report
    * data-action=toggle-reaction

    Context variables required for this template:
    * id - Post id.
    * authorname - Full name of the author.
    * authorpictureurl - URL of the author profile picture.
    * timecreated - Unix timestamp of the post.
    * content - Post content, already formatted with format_text().
    * isannouncement - Boolean, true when the post type is announcement.
    * hasreacted - Boolean, true when the current user has reacted to the post.
    * reactions - Number of reactions of the post.
    * postid - Id of this post (same as id), passed to the comments template.
    * comments - List of comments, using the local_chuspasocial/comments context.
    * tags - List of tags of the post. Each one has:
        * name - Tag name.
        * url - URL of the tag page.

    Example context (json):
    {
        "id": 1,
        "authorname": "Ana Pérez",
        "authorpictureurl": "https://example.com/pix/u/f2.png",
        "timecreated": 1760000000,
        "content": "<p>La biblioteca abre hasta las 20:00.</p>",
        "isannouncement": true,
        "hasreacted": true,
        "reactions": 3,
        "postid": 1,
        "comments": [
            {
                "id": 10,
                "authorname": "Luis Mamani",
                "timecreated": 1760003600,
                "content": "<p>Gracias por el aviso.</p>"
            }
        ],
        "tags": [
            {"name": "calculo", "url": "https://example.com/tag/index.php?tag=calculo"},
            {"name": "venta", "url": "https://example.com/tag/index.php?tag=venta"}
        ]
    }
}}
<article class="card mb-3 post-item{{#isannouncement}} local-chuspasocial-announcement{{/isannouncement}}" data-postid="{{id}}">
    <div class="card-body">
        {{#isannouncement}}
        <div class="mb-2 font-weight-bold">
            {{#pix}} i/bullhorn, core {{/pix}}
            Anuncio oficial
        </div>
        {{/isannouncement}}
        <div class="d-flex align-items-center mb-2">
            <img src="{{authorpictureurl}}" class="rounded-circle mr-2" width="35" height="35" alt="">
            <div>
                <div class="font-weight-bold">{{authorname}}</div>
                <small class="text-muted">{{#userdate}} {{timecreated}}, {{#str}} strftimedatetime, core_langconfig {{/str}} {{/userdate}}</small>
            </div>
        </div>
        <div class="card-text">{{{content}}}</div>
        {{#tags.0}}
        <div class="mt-2">
            <span class="sr-only">{{#str}} tags, core_tag {{/str}}</span>
            {{#tags}}
            <a href="{{url}}" class="badge badge-info mr-1">{{name}}</a>
            {{/tags}}
        </div>
        {{/tags.0}}

        <div class="post-images d-flex flex-wrap mt-3">
            {{#images}}
            <img src="{{url}}"
                 class="img-fluid rounded m-1"
                 alt="{{filename}}"
                 loading="lazy">
            {{/images}}
        </div>

        <button type="button" class="btn btn-link mt-2" data-action="toggle-reaction" data-postid="{{id}}"
                aria-pressed="{{#hasreacted}}true{{/hasreacted}}{{^hasreacted}}false{{/hasreacted}}"
                aria-label="{{#str}} chuspasocial:react, local_chuspasocial {{/str}}">
            {{#pix}} i/star, core {{/pix}}
            <span class="reaction-count" data-region="reaction-count">{{reactions}}</span>
        </button>

        <button type="button" class="btn btn-link mt-2" data-action="report" data-postid="{{id}}"
                aria-label="{{#str}} chuspasocial:report, local_chuspasocial {{/str}}">
            {{#str}} chuspasocial:report, local_chuspasocial {{/str}}
        </button>
        {{> local_chuspasocial/comments}}
    </div>
</article>
